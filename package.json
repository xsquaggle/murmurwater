{
  "name": "murmurwater",
  "productName": "Murmurwater",
  "version": "0.1.1",
  "description": "A cozy-but-weird fishing incremental.",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "sim": "tsx tools/sim/run.ts",
    "voice": "tsx tools/voice-manifest.ts",
    "electron": "electron .",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "typecheck": "tsc --noEmit",
    "e2e": "node e2e/play.cjs shots",
    "electron:dev": "vite build && electron ."
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "postprocessing": "^6.39.6",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "com.xsquaggle.murmurwater",
    "productName": "Murmurwater",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Murmurwater",
      "artifactName": "Murmurwater-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "Murmurwater-${version}-portable.exe"
    }
  },
  "author": "Murmurwater"
}
