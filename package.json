{
  "name": "murmurwater",
  "productName": "Murmurwater",
  "version": "0.1.0",
  "description": "A cozy-but-weird fishing incremental.",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
